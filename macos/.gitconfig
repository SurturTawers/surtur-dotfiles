# This is Git's per-user configuration file.
#[user]
#	name = DavidTorres-kastor
#  email = david.torres@kastor.cl
#[credential]
#	username=DavidTorres-kastor
#	helper="!f() { test \"$1\" = get && echo \"password=$(cat ~/.tokendtkastor)\"; }; f"
[core]
  editor = nvim
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  line-numbers = true
  dark = true
[merge]
  conflictStyle = zdiff3
[diff]
  colorMoved = default
[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
