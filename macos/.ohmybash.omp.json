{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "rosewater": "#F5E0DC",
    "pink": "#F5C2E7",
    "mauve": "#CBA6F7",
    "red": "#F38BA8",
    "peach": "#FAB387",
    "yellow": "#F9E2AF",
    "green": "#A6E3A1",
    "sapphire": "#74C7EC",
    "blue": "#89B4FA",
    "lavender": "#B4BEFE",
    "text": "#CDD6F4",
    "overlay1": "#7F849C",
    "os": "#ACB0BE",
    "closer": "p:os"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "cache_duration": "none",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_user": true,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .UpstreamIcon }} {{ .User.Name }} {{ .HEAD }} {{ .Working.String }} ",
          "foreground": "p:lavender",
          "type": "git",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "aws",
          "style": "plain",
          "foreground": "p:peach",
          "template": "AWS {{.Profile}}{{if .Region}}@{{.Region}}{{end}} "
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "p:sapphire",
          "template": "\uf308 {{ .Context }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "\ue5fe ",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": "{{ .Path }} ",
          "foreground": "p:pink",
          "type": "path",
          "style": "plain"
        },
        {
          "type": "angular",
          "style": "plain",
          "foreground": "p:red",
          "template": "\ue753 {{ .Full }} "
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "\ue73d {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": "\ue718 {{ .Full }} "
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:os",
          "template": "{{.Icon}}  "
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{.UserName}}@{{.HostName}} ",
          "foreground": "p:blue",
          "type": "text",
          "style": "plain"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:closer",
          "template": "\uf105"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
