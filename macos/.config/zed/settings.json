{
  "title_bar": {
    "show_branch_status_icon": false
  },
  "tabs": {
    "git_status": true
  },
  "remove_trailing_whitespace_on_save": false,
  "indent_guides": {
    "line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "soft_wrap": "editor_width",
  "scrollbar": {
    "show": "auto",
    "axes": {
      "horizontal": true
    }
  },
  "horizontal_scroll_margin": 5.0,
  "format_on_save": "off",
  "which_key": {
    "enabled": true
  },
  "diff_view_style": "split",
  "agent": {
    "sidebar_side": "left",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "qwen-code": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "model": "opus[1m]"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "vim_mode": true,
  "tab_size": 2,
  "line_numbers": "absolute",
  "cursor_line": "active",
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 14.0,
  "buffer_font_size": 12,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": "Duskfox - blurred",
  "features": {
    "copilot": true
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "file_icons": true,
    "sort_by_path": false,
    "collapse_untracked_diff": false,
    "tree_view": true,
    "dock": "left"
  }
}
